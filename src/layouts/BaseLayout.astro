---
import '@/styles/global.css';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { site } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  appendSchema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = site.name,
  description = site.description,
  image = '/images/og-yahiko-park.jpg',
  noindex = false,
  structuredData,
  appendSchema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).toString();
const fullTitle = title.includes(site.name) ? title : `${title}｜${site.name}`;
const socialImage = new URL(image, site.url).toString();
const defaultStructuredData = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'Park'],
  '@id': `${site.url}/#attraction`,
  name: '弥彦公園',
  alternateName: ['Yahiko Park', '弥彦村 弥彦公園'],
  description: site.description,
  url: site.url,
  image: [socialImage],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '弥彦667-1',
    addressLocality: '弥彦村',
    addressRegion: '新潟県',
    postalCode: '959-0323',
    addressCountry: 'JP',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.coordinates.latitude,
    longitude: site.coordinates.longitude,
  },
  hasMap: site.mapsShareUrl,
  sameAs: [
    site.mapsShareUrl,
    site.tourismUrl,
    site.villageUrl,
  ],
  isAccessibleForFree: true,
};

const structuredDataOutput = structuredData
  ?? (appendSchema
    ? [defaultStructuredData, ...(Array.isArray(appendSchema) ? appendSchema : [appendSchema])]
    : defaultStructuredData);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#243b2a" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <title>{fullTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredDataOutput)} />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP', { anonymize_ip: true });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />

    <!-- PWA: register service worker for offline-capable installable experience -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
