---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Weather from '@/components/Weather.astro';
import Amenities from '@/components/Amenities.astro';
import SeasonalStrategy from '@/components/SeasonalStrategy.astro';
import TourRoutes from '@/components/TourRoutes.astro';
import ParkScience from '@/components/ParkScience.astro';
---

<BaseLayout
  title="弥彦公園を知る・訪問ガイド"
  description="弥彦公園の天気・周辺施設・季節の戦略・回り方・歴史と自然を、非公式の非営利ガイドとして中立的にまとめます。"
>
  <PageHero
    eyebrow="VISITOR GUIDE"
    title="弥彦公園を、知って歩く。"
    lead="天気の目安から周辺の施設、季節ごとの戦略、回り方、歴史と自然まで。中立的でわかりやすい訪問ガイドです。"
    image="yahiko-momiji"
    imageAlt="紅葉に包まれた弥彦公園の観月橋"
    status="非公式・非営利の私設ガイド"
  />

  <Weather />
  <Amenities />
  <SeasonalStrategy />
  <TourRoutes />
  <ParkScience />
  <section class="section-space bg-paper" aria-labelledby="site-about-title">
    <div class="container-shell max-w-4xl">
      <p class="text-xs font-bold tracking-[.2em] text-moss/60">ABOUT THIS GUIDE</p>
      <h2 id="site-about-title" class="mt-4 text-3xl text-moss">弥彦公園ガイドについて</h2>
      <p class="mt-3 text-sm font-semibold tracking-[.08em] text-ink/55">YahikoPark.com</p>
      <p class="mt-6 text-base leading-9 text-ink/75">当サイトは、紅葉、桜、ライトアップ、交通、散策コースの情報を旅行前に整理できるようまとめた非公式の観光ガイドです。訪問の際は、現地で発表される最新情報と案内を優先してください。</p>
      <h3 class="mt-10 text-xl text-moss">運営と公式機関との関係</h3>
      <p class="mt-4 text-base leading-9 text-ink/75">YahikoPark.comは、弥彦村、弥彦公園および関連団体の公式ウェブサイトではありません。各施設の運営・管理に関する案内は、該当する公式機関の発表をご確認ください。</p>
      <a href="/sources/" class="btn-secondary mt-8">資料の出典と評価の参照元を見る</a>
    </div>
  </section>
</BaseLayout>
