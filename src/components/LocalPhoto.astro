---
interface Props {
  name: 'yahiko-momiji' | 'yahiko-snow' | 'yahiko-station-sakura' | 'yahiko-street';
  alt: string;
  caption?: string;
  credit?: string;
  loading?: 'eager' | 'lazy';
  objectPosition?: string;
  class?: string;
  imageClass?: string;
}

const dimensions = {
  'yahiko-momiji': [1280, 960],
  'yahiko-snow': [1280, 960],
  'yahiko-station-sakura': [1280, 913],
  'yahiko-street': [1280, 853],
} as const;

const {
  name,
  alt,
  caption,
  credit,
  loading = 'lazy',
  objectPosition = 'center',
  class: className = '',
  imageClass = '',
} = Astro.props;
const [width, height] = dimensions[name];
---

<figure class={className}>
  <picture class="photo-frame block h-full w-full">
    <source
      type="image/webp"
      srcset={`/images/${name}-640.webp 640w, /images/${name}-960.webp 960w, /images/${name}-1280.webp 1280w`}
      sizes="(max-width: 768px) 100vw, 60vw"
    />
    <img
      src={`/images/${name}-1280.webp`}
      width={width}
      height={height}
      alt={alt}
      loading={loading}
      decoding="async"
      fetchpriority={loading === 'eager' ? 'high' : 'auto'}
      class={`h-full w-full object-cover ${imageClass}`}
      style={`object-position:${objectPosition}`}
    />
  </picture>
  {(caption || credit) && (
    <figcaption class="mt-3 flex flex-wrap items-start justify-between gap-x-4 gap-y-1 text-[.69rem] leading-5 tracking-[.04em] text-ink/50">
      {caption && <span>{caption}</span>}
      {credit && <span>写真：{credit}</span>}
    </figcaption>
  )}
</figure>
