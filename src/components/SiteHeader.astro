---
import { navigation, site } from '@/data/site';
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-moss/10 bg-paper/[.92] backdrop-blur-xl">
  <div class="container-shell flex h-[76px] items-center justify-between gap-6">
    <a href="/" class="group flex items-center gap-3 no-underline" aria-label={`${site.name} ホーム`}>
      <span class="grid size-10 place-items-center rounded-full bg-moss text-gold" aria-hidden="true">
        <svg viewBox="0 0 32 32" class="size-6" fill="none">
          <path d="M7 24 24 7M8 10c7 1 12 6 13 13M13 6c4 2 8 6 10 10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="leading-tight">
        <span class="block font-serif-jp text-[1.05rem] tracking-[.14em] text-moss">弥彦公園</span>
        <span class="block text-[.62rem] tracking-[.19em] text-ink/55">SEASONAL WALK GUIDE</span>
      </span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="メインナビゲーション">
      {navigation.map((item) => (
        <a
          href={item.href}
          class:list={[
            'relative py-2 text-[.78rem] font-bold tracking-[.08em] no-underline transition-colors hover:text-vermilion',
            path.startsWith(item.href) ? 'text-vermilion' : 'text-ink/76',
          ]}
          aria-current={path.startsWith(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <a href="/faq/" class="btn-secondary !min-h-10 !px-4 !py-1.5">よくある質問</a>
    </nav>

    <button
      id="menu-button"
      class="grid size-11 place-items-center rounded-full border border-moss/20 bg-paper text-moss lg:hidden"
      type="button"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="メニューを開く"
    >
      <svg id="menu-open-icon" viewBox="0 0 24 24" class="size-5" fill="none" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
      </svg>
      <svg id="menu-close-icon" viewBox="0 0 24 24" class="hidden size-5" fill="none" aria-hidden="true">
        <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-moss/10 bg-paper lg:hidden">
    <nav class="container-shell grid gap-1 py-4" aria-label="モバイルナビゲーション">
      {navigation.map((item) => (
        <a
          href={item.href}
          class:list={[
            'flex items-center justify-between rounded-xl px-4 py-3 text-sm font-bold no-underline',
            path.startsWith(item.href) ? 'bg-washi text-vermilion' : 'text-ink/80',
          ]}
        >
          <span>{item.label}</span><span aria-hidden="true">→</span>
        </a>
      ))}
      <a href="/faq/" class="flex items-center justify-between rounded-xl px-4 py-3 text-sm font-bold no-underline text-ink/80">
        <span>よくある質問</span><span aria-hidden="true">→</span>
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  const button = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  button?.addEventListener('click', () => {
    const expanded = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!expanded));
    button.setAttribute('aria-label', expanded ? 'メニューを開く' : 'メニューを閉じる');
    menu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>
