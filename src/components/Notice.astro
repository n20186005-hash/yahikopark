---
interface Props {
  label?: string;
  title: string;
  body: string;
  tone?: 'season' | 'info';
}
const { label = 'お知らせ', title, body, tone = 'info' } = Astro.props;
---

<div class:list={[
  'grid gap-5 border px-6 py-6 sm:grid-cols-[auto_1fr] sm:items-start sm:px-8',
  tone === 'season' ? 'border-vermilion/25 bg-vermilion/5' : 'border-moss/15 bg-washi/70',
]}>
  <span class:list={[
    'inline-flex w-fit rounded-full px-3 py-1 text-[.66rem] font-bold tracking-[.14em]',
    tone === 'season' ? 'bg-vermilion text-paper' : 'bg-moss text-paper',
  ]}>{label}</span>
  <div>
    <h2 class="text-xl leading-relaxed text-moss sm:text-2xl">{title}</h2>
    <p class="mt-2 text-sm leading-7 text-ink/66">{body}</p>
  </div>
</div>
