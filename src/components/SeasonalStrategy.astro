---
import SectionTitle from '@/components/SectionTitle.astro';

// 季節の戦略表。気象は「気象庁 平年値（1991–2020）」を基準とした日本海側・新潟平野西部の代表的な目安。
// 水质・野生動物は日本海沿岸生態の一般的な傾向を、科学的な注意点としてまとめる（非営利の科普サイトとして）。
const rows = [
  {
    season: '春',
    months: '3月〜5月',
    temp: '8℃ → 18℃（目安）',
    rain: '中程度・不安定',
    wear: '羽織るもの、薄手の上着',
    highlight: 'ソメイヨシノから八重桜へ。雪解け水の渓流も魅力的。',
    caution: '朝晩の冷え込みと残雪の路面に注意。',
  },
  {
    season: '夏',
    months: '6月〜8月',
    temp: '22℃ → 27℃（目安）',
    rain: '梅雨（6-7月）・台風（8-9月）',
    wear: '通気性の服装、雨具',
    highlight: '新緑と水音、蛍の見られる時期も。夏休みは混雑しやすい。',
    caution: '湿度が高く、こまめな水分補給を。雷・突風に注意。',
  },
  {
    season: '秋',
    months: '9月〜11月',
    temp: '24℃ → 11℃（目安）',
    rain: '台風の残響、のち乾燥',
    wear: '重ね着、赤外線対策',
    highlight: 'もみじ谷と観月橋が代表。11月上旬〜中旬が見頃の目安。',
    caution: '紅葉期の休日は駐車場・道路が混雑。早めの行動を。',
  },
  {
    season: '冬',
    months: '12月〜2月',
    temp: '2℃ → 4℃（目安）',
    rain: '日本海側の豪雪',
    wear: '防寒着、滑りにくい靴',
    highlight: '雪化粧の橋と木立。静かな景色が楽しめる。',
    caution: '積雪・凍結で足元と交通状況を確認。除雪車に譲る。',
  },
];

const cols = [
  ['季節', 'season'],
  ['時期', 'months'],
  ['気温の目安', 'temp'],
  ['降水の傾向', 'rain'],
  ['服装・持ち物', 'wear'],
  ['見どころ', 'highlight'],
  ['注意点', 'caution'],
] as const;
---

<section class="section-space bg-washi/65" id="season">
  <div class="container-shell">
    <SectionTitle
      eyebrow="SEASONAL STRATEGY"
      title="季節を読む、旅の戦略表"
      description="気象の目安は気象庁の平年値（1991–2020）を基にした日本海側・新潟平野西部の代表的な値です。当年の実際の気温や開花・色づきは年ごとに変わります。"
    />

    <div class="mt-12 overflow-x-auto">
      <table class="w-full min-w-[860px] border-collapse text-sm">
        <thead>
          <tr class="bg-moss text-paper">
            {cols.map((c) => <th class="border border-moss/30 px-4 py-3 text-left font-bold tracking-[.06em]">{c[0]}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r, i) => (
              <tr class:list={['align-top', i % 2 === 0 ? 'bg-paper' : 'bg-washi/50']}>
                <th class="border border-moss/12 px-4 py-4 text-left font-serif-jp text-lg text-vermilion">{r.season}</th>
                {cols.slice(1).map((c) => (
                  <td class="border border-moss/12 px-4 py-4 leading-7 text-ink/68">{r[c[1]]}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <article class="washi-panel p-7 sm:p-9">
        <p class="text-xs font-bold tracking-[.15em] text-vermilion">WATER</p>
        <h3 class="mt-3 text-xl text-moss">水辺の質と安全</h3>
        <p class="mt-4 text-sm leading-8 text-ink/66">
          弥彦の水辺は湧水と渓流が中心です。夏場は水温が低く、遊泳や川遊びは想定されていません。雨天後は増水や滑りやすい岩場に注意し、ゴミの持ち帰りで水質を守ります。
        </p>
      </article>
      <article class="washi-panel p-7 sm:p-9">
        <p class="text-xs font-bold tracking-[.15em] text-vermilion">WILDLIFE</p>
        <h3 class="mt-3 text-xl text-moss">野生動物とのつきあい</h3>
        <p class="mt-4 text-sm leading-8 text-ink/66">
          日本海側の里山・海岸林として、渡り鳥をはじめとする鳥類が観察されやすい時期があります。野生動物への餌やりは生態系のバランスを崩すため行いません。遠くから静かに観察するのが望ましいです。
        </p>
      </article>
    </div>

    <p class="mt-8 max-w-3xl text-xs leading-6 text-ink/50">
      ※ 数値は「平年値」という過去30年程度の平均的な傾向です。実際の天候や開花・色づきはその年の気温や雨、風で大きく変わるため、直前の情報をご確認ください。
    </p>
  </div>
</section>
